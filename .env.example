# Copy to .env and adjust. Every service is bound to 127.0.0.1 — never edit that binding
# to make the stack reachable from the network (see PRD section 13).
#
# This is the template for working from a checkout. An installed system never uses it: the
# launcher writes its own .env on first run, with generated secrets and no COMPOSE_FILE line
# (launcher/core/src/bootstrap.rs).

# --- Which compose files a bare `docker compose` command uses ---
# docker-compose.yml alone describes an installed system and pulls published images. From a
# checkout you almost always want the two overlays as well: build the images from ./backend and
# ./frontend, and run the frontend as `next dev` off a bind mount so hot reload works. Docker
# Compose reads this variable from .env, so `docker compose up -d --build` needs no -f flags.
COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml:docker-compose.dev.yml

# --- Published images (used when not building from source) ---
PCB_INSPECT_REGISTRY=ghcr.io/arthursantos67
PCB_INSPECT_VERSION=latest

# --- Ports published on the host (127.0.0.1 only) ---
API_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
REDIS_PORT=6379

# --- Postgres ---
POSTGRES_USER=pcb_inspect
POSTGRES_PASSWORD=pcb_inspect
POSTGRES_DB=pcb_inspect

# --- Backend ---
# Signs session tokens (section 13) — use a random value at least 32 characters long,
# e.g. `openssl rand -hex 32`.
SECRET_KEY=change-me-to-a-random-value
DATABASE_URL=postgresql+asyncpg://pcb_inspect:pcb_inspect@db:5432/pcb_inspect
REDIS_URL=redis://redis:6379/0
# Language a fresh station starts in: en or pt. Only the initial value — once someone picks a
# language in Settings > General it is stored in the database and this line stops mattering.
DEFAULT_LANGUAGE=en
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Local filesystem paths, as seen *inside* the containers. WATCH_ROOT is mounted read-only;
# APP_DATA_DIR (database volume, annotated images, reports, uploaded model weights) is writable.
WATCH_ROOT=/data/watch-root
APP_DATA_DIR=/data/app-data

# Host-side paths bind-mounted into the containers above — point these at real directories
# on the machine running the inspection station.
WATCH_ROOT_HOST_PATH=./data/watch-root
APP_DATA_HOST_PATH=./data/app-data

# Where the YOLO weight file lives on the host. `best.pt` is 114 MB and not tracked in git —
# from a checkout, download it here yourself (root README); an installed system points this at
# the install directory, where the launcher downloads it on first run.
WEIGHTS_HOST_PATH=./weights

# Host filesystem mounted read-only into the backend containers, so the watch root can be
# changed to any folder from Settings > Ingestion without editing this file and restarting the
# stack. HOST_FS_SOURCE is the directory to expose, written the way the *host* spells paths
# (narrow it to e.g. /home to restrict what the containers can read; on Windows it must be a
# drive path such as C:/Users/you). HOST_FS_MOUNT is where it lands inside the containers.
# HOST_FS_ROOT is the prefix the backend maps that mount back to when it shows a path to the
# operator — the same value as HOST_FS_SOURCE on Linux, and `/` on Windows, where host paths
# have no POSIX form. Set HOST_FS_MOUNT empty when running the backend directly on the host,
# where no translation is needed.
HOST_FS_SOURCE=/
HOST_FS_ROOT=/
HOST_FS_MOUNT=/hostfs

# LLM — local-first by default (LM Studio/Ollama). Only set an API key if opting into a
# cloud provider (PRD section 5.2); this is never required to run the project locally.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=local-model
LLM_API_KEY=
LLM_TIMEOUT_S=60
# Caps a single completion on the chat path (the structured agent calls do not cap themselves).
# Raise it if the chat runs on a hosted reasoning model: there the thinking tokens are billed
# against this same budget, so a value tuned for a local non-reasoning model truncates the
# answer before any of it is written.
LLM_MAX_TOKENS=800
# Sent as `reasoning_effort` when non-empty, omitted when blank — leave it blank for a local
# model. It matters for hosted reasoning models under forced JSON output, where the accepted
# values are model-specific: Groq's qwen3.6 takes only `none` or `default` and *requires*
# `none` for the agent chain to work at all, while OpenAI's reasoning models take
# `low`/`medium`/`high`. Set it per role below rather than globally unless every tier shares
# one model.
LLM_REASONING_EFFORT=

# Per-role LLM endpoints (optional). The chat, the analysis chain and the report narrative
# ask different things of a model, and they do not have to share one provider. Any field left
# blank falls back to the LLM_* value above, so a single-endpoint station can ignore this
# whole block; setting only LLM_CHAT_MODEL, for instance, moves just the chat onto a
# different model of the same endpoint.
#
# Values that are *not* secret (base_url, model) can equally live in Settings > Detection,
# which stores them in the database and takes precedence over what is set here.
#
# Example of a hosted split — Groq for the two heavier tiers, Google for the chat:
#   LLM_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_CHAT_MODEL=gemini-3.5-flash-lite
#   LLM_ANALYSIS_BASE_URL=https://api.groq.com/openai/v1
#   LLM_ANALYSIS_MODEL=qwen/qwen3.6-27b
#   LLM_ANALYSIS_REASONING_EFFORT=none
#   LLM_REPORT_BASE_URL=https://api.groq.com/openai/v1
#   LLM_REPORT_MODEL=openai/gpt-oss-120b
LLM_CHAT_BASE_URL=
LLM_CHAT_MODEL=
LLM_CHAT_API_KEY=
LLM_CHAT_REASONING_EFFORT=
LLM_ANALYSIS_BASE_URL=
LLM_ANALYSIS_MODEL=
LLM_ANALYSIS_API_KEY=
LLM_ANALYSIS_REASONING_EFFORT=
LLM_REPORT_BASE_URL=
LLM_REPORT_MODEL=
LLM_REPORT_API_KEY=
LLM_REPORT_REASONING_EFFORT=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origins allowed to call the API from a browser (comma-separated) — the frontend is a
# separate origin from the API even though both are localhost-only (section 13).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
